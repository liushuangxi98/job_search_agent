# Copy to .env and fill only your local MySQL credentials. No model keys required.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=job_search_agent

# demo: clearly labelled fixed samples; real: your own Agent implementation.
AGENT_MODE=demo

# 真实岗位评估的公交和驾车查询使用高德 Web 服务 Key。
AMAP_API_KEY=
